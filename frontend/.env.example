# ---- Browser (VITE_*): public, baked into the bundle at build time ------------------------------
# Wallet: MetaMask, connected directly (nothing to configure). The chain values below are written to .env.local by `npm run deploy:local` (contracts/): you normally leave them empty here.
# Private local chain (contracts/localnet): geth Clique, chainId 105701, two nodes. The app uses node 2, the RPC node.
VITE_CHAIN_ID=105701
# VITE_CHAIN_NAME=Localnet
VITE_RPC_URL=http://127.0.0.1:8546
# Logs endpoint (default: VITE_RPC_URL)
# VITE_LOGS_RPC_URL=
# Deploy block of CardCollection (deployments.localnet.json → deployBlock); events are read from here
VITE_DEPLOY_BLOCK=
VITE_ADMIN_ADDRESS=
VITE_COLLECTION_ADDRESS=
VITE_PACKSALE_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
# A private chain has no public explorer; set this if you run one (e.g. Blockscout) to get tx/address links
# VITE_EXPLORER_URL=
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- Server only (api/, served by `npm run dev` on the same port): never name these VITE_* ----
# Pack Builder pinning (/api/pin). PINATA_JWT is required to publish a set: app.pinata.cloud → API Keys → New Key
# (pinFileToIPFS is enough), paste the JWT here. Server side only; restart `npm run dev` after changing it.
PINATA_JWT=
# Who may pin: the CardCollection to check hasRole(ADMIN_ROLE) on ...
COLLECTION_ADDRESS=
# ... or an explicit comma-separated allow-list
ADMIN_ADDRESSES=
# RPC used for that role check (default: node 2 of the local chain, http://127.0.0.1:8546)
CHAIN_RPC_URL=
# Reference prices (/api/price): "Sắp ra mắt" for now (src/lib/features.ts → PRICE_REF_ENABLED). Anonymous tier is 10 requests/day/IP
RENAISS_API_KEY=
RENAISS_API_SECRET=
