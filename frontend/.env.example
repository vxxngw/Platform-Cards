# ---- Browser (VITE_*): public, baked into the bundle at build time ------------------------------
VITE_CHAIN_ID=11155111
# Sepolia RPC (Alchemy/Infura/…). Public: restrict the key to your domain in the provider dashboard.
VITE_RPC_URL=
# Alchemy free tier limits eth_getLogs to 10 blocks; logs use this endpoint (default: publicnode on Sepolia).
# VITE_LOGS_RPC_URL=
# Deploy block of CardCollection (deployments.sepolia.json → deployBlock); events are read from here
VITE_DEPLOY_BLOCK=
VITE_ADMIN_ADDRESS=
VITE_COLLECTION_ADDRESS=
VITE_PACKSALE_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- Server only (api/ serverless functions): set in Vercel → Environment Variables, never as VITE_* ----
# Pack Builder pinning (/api/pin). PINATA_JWT is required to publish a set.
PINATA_JWT=
# Who may pin: the CardCollection to check hasRole(ADMIN_ROLE) on ...
COLLECTION_ADDRESS=
# ... or an explicit comma-separated allow-list
ADMIN_ADDRESSES=
# RPC used for that role check (default: public Sepolia node)
CHAIN_RPC_URL=
# Reference prices (/api/price), optional: anonymous tier is 10 requests/day/IP
RENAISS_API_KEY=
RENAISS_API_SECRET=
