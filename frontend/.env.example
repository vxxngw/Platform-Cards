# Existing dev server vars (see scripts/check-env.cjs)
PORT=5173
BACKEND_PORT=3001
BASE_PATH=./

# --- On-chain mode (Sepolia). Leave VITE_CHAIN_MODE unset to keep the off-chain demo. ---
VITE_CHAIN_MODE=onchain
VITE_CHAIN_ID=11155111
# Use a provider with generous eth_getLogs ranges (Alchemy/Infura/…); the public default may be slow.
VITE_RPC_URL=
# Alchemy free tier limits eth_getLogs to 10 blocks; logs use this endpoint (default: publicnode on Sepolia).
# VITE_LOGS_RPC_URL=
# Block number printed by `hardhat run scripts/deploy.js` (events are read from here)
VITE_DEPLOY_BLOCK=
VITE_ADMIN_ADDRESS=
VITE_COLLECTION_ADDRESS=
VITE_PACKSALE_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Backend hosted on another origin (leave empty for same-origin /api)
# VITE_API_URL=https://<backend-host>
