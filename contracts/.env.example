# Local 2-node network (npm run chain:*): nothing to set. Optional overrides:
# LOCALNET_RPC_URL=http://127.0.0.1:8546
# LOCALNET_PRIVATE_KEY=          # deploy from this key instead of Hardhat dev account #0
BASE_URI=https://<app>/api/metadata/

# Legacy Sepolia deployment (deployments.sepolia.json) — no longer used
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
