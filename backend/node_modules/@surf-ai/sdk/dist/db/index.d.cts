/**
 * Shared schema sync logic — used by both Express runtime (createServer)
 * and Next.js template (instrumentation.ts).
 *
 * Reads a Drizzle schema file, provisions the database, creates missing
 * tables, and adds missing columns to existing tables.
 */
interface SchemaSyncOptions {
    /** Path to the schema file (e.g., 'db/schema.js' or 'db/schema.ts') */
    schemaPath: string;
    /** Number of retries on failure (default: 3) */
    retries?: number;
    /** Base delay between retries in ms (default: 2000) */
    retryDelay?: number;
}
/**
 * Sync a Drizzle schema file to the database.
 *
 * - Provisions the database via the Surf proxy
 * - Creates missing tables using drizzle-kit DDL generation
 * - Adds missing columns to existing tables via ALTER TABLE
 */
declare function syncSchema(options: SchemaSyncOptions): Promise<void>;
/**
 * Watch a schema file for changes and re-sync on edit.
 * Returns a cleanup function to stop watching.
 */
declare function watchSchema(schemaPath: string, options?: {
    debounceMs?: number;
    retries?: number;
    retryDelay?: number;
}): () => void;

/**
 * @surf-ai/sdk/db — Database helpers via HTTP proxy to Neon PostgreSQL.
 *
 * All queries go through the Surf API proxy. There is no locally-instantiated
 * Drizzle ORM client — `drizzle-orm/pg-core` is used only to declare the
 * schema; reads and writes go through dbQuery().
 *
 * Usage:
 *   const { dbQuery } = require('@surf-ai/sdk/db')
 *   const { rows } = await dbQuery('SELECT * FROM users WHERE id = $1', [userId])
 */

/**
 * Provision a database for the current user via db/provision.
 * Returns connection metadata. Neon auto-creates the DB if it doesn't exist.
 */
declare function dbProvision(): Promise<{
    host: string;
    database: string;
    user: string;
    password: string;
}>;
/**
 * Execute a SQL query via db/query.
 *
 * Returns a pg-style result — use `result.rows` for the row data:
 *   const { rows } = await dbQuery('SELECT * FROM users')
 *   const [row] = (await dbQuery('INSERT ... RETURNING *', [...])).rows
 *
 * @param options.arrayMode - When true, each row is a positional array instead
 *   of an object keyed by column name. Default false (object rows).
 */
declare function dbQuery(sql: string, params?: any[], options?: {
    arrayMode?: boolean;
}): Promise<{
    rows: any[];
    rowCount?: number;
    fields?: Array<{
        name: string;
        type: string;
    }>;
    truncated?: boolean;
}>;
/**
 * List tables in the user's database.
 */
declare function dbTables(): Promise<string[]>;
/**
 * Get schema for a specific table.
 */
declare function dbTableSchema(table: string): Promise<any>;
/**
 * Check database connection status.
 */
declare function dbStatus(): Promise<{
    connected: boolean;
    database?: string;
}>;

export { type SchemaSyncOptions, dbProvision, dbQuery, dbStatus, dbTableSchema, dbTables, syncSchema, watchSchema };
