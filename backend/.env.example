# Platform (see scripts/check-env.js)
BACKEND_PORT=3001
SURF_API_KEY=

# --- Pack Builder: /api/pin (spec v2) ---------------------------------------------------------
# Pinata JWT (server only, never VITE_*). Without it metadata is stored in the database and served by /api/metadata/<id>.json.
PINATA_JWT=
# Who may pin: either an explicit allow-list ...
ADMIN_ADDRESSES=
# ... or the CardCollection to check hasRole(ADMIN_ROLE) on (RPC defaults to a public Sepolia node)
COLLECTION_ADDRESS=
CHAIN_RPC_URL=

# --- Reference prices: /api/price (optional; anonymous tier is 10 requests/day/IP) -------------
RENAISS_API_KEY=
RENAISS_API_SECRET=
